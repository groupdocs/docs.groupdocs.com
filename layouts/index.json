{{- /* Site search index consumed by the header search (partials/header-search.html).
       Compact title + href per page — no page body, so the file stays small enough to fetch
       client-side. (The theme's FlexSearch, which used the old {id,parent,content} schema, is
       disabled via GeekdocSearch=false, so nothing else reads this file.) */ -}}
[
  {{- $first := true -}}
  {{- range $page := .Site.Pages -}}
    {{- $title := partial "utils/title" $page -}}
    {{- if $title -}}
      {{- if not $first }},{{ end -}}{{- $first = false -}}
      { "href": "{{ $page.RelPermalink }}", "title": {{ $title | jsonify }} }
    {{- end -}}
  {{- end -}}
]
